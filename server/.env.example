# Environment configuration for backend

# Server port
PORT=3001

# Node environment — controls which database adapter is used:
#   development → SQLite (local file at server/tracker.db, no credentials needed)
#   production  → Turso  (cloud libsql, requires credentials below)
NODE_ENV=development

# Turso Database Credentials (only required when NODE_ENV=production)
# Get these from your Turso dashboard: https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here
